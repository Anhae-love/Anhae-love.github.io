# .github/workflows/pages.yml
# docs/ 폴더가 push되면 GitHub Pages로 자동 발행한다.
# 대시보드(docs/index.html)와 데이터(docs/data, docs/cards)가 여기서 웹으로 뜬다.
name: Deploy dashboard to Pages

on:
  push:
    branches: [main]
    paths:
      - "docs/**"
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: docs
      - id: deployment
        uses: actions/deploy-pages@v4
